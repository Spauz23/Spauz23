RewriteEngine On

# Un solo indirizzo per il sito: www.artebianca.be -> artebianca.be
RewriteCond %{HTTP_HOST} ^www\.artebianca\.be$ [NC]
RewriteRule ^(.*)$ https://artebianca.be/$1 [R=301,L]

# /index.html (anche nelle sottocartelle) -> indirizzo della cartella
RewriteCond %{THE_REQUEST} \s/+(\S*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L,NC]

# Vecchie pagine per lingua (/it, /fr, /en): ora la lingua si sceglie nella home
RedirectMatch 301 ^/(it|fr|en)(/.*)?$ /

# Vecchio indirizzo della pagina di prenotazione
RedirectMatch 301 ^/prenota/?$ /reservation/

# Compressione dei file di testo
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Cache del browser: le visite successive non riscaricano video e immagini
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
